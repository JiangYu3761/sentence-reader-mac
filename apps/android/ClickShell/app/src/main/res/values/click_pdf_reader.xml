<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ClickPdfReaderTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/click_canvas_dark</item>
        <item name="android:navigationBarColor">@color/click_canvas_dark</item>
        <item name="android:statusBarColor">@color/click_canvas_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorSurface">@color/click_surface_dark</item>
        <item name="colorOnSurface">@color/click_label_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/click_label_secondary_dark</item>
        <item name="colorAccent">@color/click_accent_dark</item>
        <item name="colorPrimary">@color/click_accent_dark</item>
        <item name="colorPrimaryDark">@color/click_canvas_dark</item>
    </style>
    <style name="ClickPdfReaderLightTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/click_canvas_light</item>
        <item name="android:navigationBarColor">@color/click_canvas_light</item>
        <item name="android:statusBarColor">@color/click_canvas_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorSurface">@color/click_surface_light</item>
        <item name="colorOnSurface">@color/click_label_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/click_label_secondary_light</item>
        <item name="colorAccent">@color/click_accent_light</item>
        <item name="colorPrimary">@color/click_accent_light</item>
        <item name="colorPrimaryDark">@color/click_canvas_light</item>
    </style>

